# Carrot in a Box — Backend Production Environment Variables

# Node Environment
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/carrot_in_a_box?sslmode=require

# Redis Cache & Matchmaking Configuration
REDIS_URL=redis://user:password@host:6379

# Session Security
SESSION_SECRET=replace_this_with_a_very_long_secure_random_string
SESSION_TTL_HOURS=24

# CORS & Frontend Origins (Comma-separated or single URL)
CORS_ORIGINS=https://your-game-domain.crazygames.com,https://www.crazygames.com,http://localhost:5173
FRONTEND_URL=https://your-game-domain.crazygames.com

# Game Timing Defaults (Optional)
MATCHMAKING_TIMEOUT_MS=30000
DISCUSSION_PHASE_SECONDS=60
DECISION_PHASE_SECONDS=30
RECONNECT_WINDOW_SECONDS=30
HEARTBEAT_INTERVAL_MS=5000
HEARTBEAT_TIMEOUT_MS=15000
