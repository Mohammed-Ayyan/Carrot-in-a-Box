# Carrot in a Box — Frontend Environment Variables

# Backend Server Connection URL
# Production: Set to your deployed backend HTTPS URL (e.g. https://carrot-backend.onrender.com)
# Development: http://localhost:3001
VITE_SERVER_URL=http://localhost:3001

# Enable Live Multiplayer Mode (true for online backend, false for local AI only)
VITE_MULTIPLAYER=true
